{
  "name": "@pawhaven/design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./index.css": "./index.css",
    "./tokens": "./src/tokens/index.css"
  },
  "files": [
    "index.css",
    "src/**"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "token-check": "node scripts/token-check.cjs"
  },
  "devDependencies": {
    "@pawhaven/eslint-config": "workspace:*",
    "@pawhaven/tsconfig": "workspace:*",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
